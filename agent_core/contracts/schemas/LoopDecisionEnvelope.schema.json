{
  "$defs": {
    "GovernanceControls": {
      "additionalProperties": false,
      "description": "Contract-level safety controls for loop decisions and learning.",
      "properties": {
        "adversarial_review_required": {
          "default": false,
          "title": "Adversarial Review Required",
          "type": "boolean"
        },
        "approval_tier": {
          "default": "none",
          "enum": [
            "none",
            "operator",
            "senior",
            "break_glass"
          ],
          "title": "Approval Tier",
          "type": "string"
        },
        "learning_allowed": {
          "default": true,
          "title": "Learning Allowed",
          "type": "boolean"
        },
        "never_learn": {
          "default": false,
          "title": "Never Learn",
          "type": "boolean"
        },
        "policy_ids": {
          "items": {
            "type": "string"
          },
          "title": "Policy Ids",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "risk_class": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Class"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sensitivity_class": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "private",
            "sensitive",
            "secret"
          ],
          "title": "Sensitivity Class",
          "type": "string"
        }
      },
      "title": "GovernanceControls",
      "type": "object"
    },
    "InsightLabel": {
