{
  "$defs": {
    "GovernanceControls": {
      "additionalProperties": false,
      "description": "Contract-level safety controls for loop decisions and learning.",
      "properties": {
        "adversarial_review_required": {
          "default": false,
          "title": "Adversarial Review Required",
          "type": "boolean"
        },
        "approval_tier": {
          "default": "none",
          "enum": [
            "none",
            "operator",
            "senior",
            "break_glass"
          ],
          "title": "Approval Tier",
          "type": "string"
        },
        "learning_allowed": {
          "default": true,
          "title": "Learning Allowed",
          "type": "boolean"
        },
        "never_learn": {
          "default": false,
          "title": "Never Learn",
          "type": "boolean"
        },
        "policy_ids": {
          "items": {
            "type": "string"
          },
          "title": "Policy Ids",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "risk_class": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Class"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sensitivity_class": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "private",
            "sensitive",
            "secret"
          ],
          "title": "Sensitivity Class",
          "type": "string"
        }
      },
      "title": "GovernanceControls",
      "type": "object"
    },
    "InsightScore": {
      "additionalProperties": false,
      "description": "Separated score object for benefit/cost reasoning.",
      "properties": {
        "components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Components",
          "type": "object"
        },
        "rationale": {
          "items": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "array"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        }
      },
      "title": "InsightScore",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A cited source with optional A0-A5 authority (from the knowledge loop).",
      "properties": {
        "authority": {
          "anyOf": [
            {
              "enum": [
                "A0",
                "A1",
                "A2",
                "A3",
                "A4",
                "A5"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority"
        },
        "commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
